# Default local demonstration. Node does not load this automatically.
# Example after project-specific authorization: node --env-file=.env server.mjs
HOST=127.0.0.1
PORT=3000
OLB_AI_ENABLED=false
# No supplier, endpoint, model or credential is selected by this repository.
# Set ALL fields only after a project owner authorizes a bounded real pilot.
OLB_AI_ADAPTER=chat-completions
OLB_AI_ENDPOINT=
OLB_AI_MODEL=
OLB_AI_KEY=
# Keep .env ignored. Never put credentials in public/, content/ or exported books.
