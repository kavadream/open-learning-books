{
  "name": "open-learning-books",
  "version": "0.3.0-dev",
  "private": true,
  "type": "module",
  "description": "An open platform for reading, creating, and practicing with teaching-focused AI books.",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server.mjs",
